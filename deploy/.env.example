# ---------------------------------------------------------------------------
# iop-toolkit deployment configuration.
# Copy to `.env` (cp .env.example .env) and adjust as needed, then run:
#   docker compose up -d --build
# ---------------------------------------------------------------------------

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root#1234
MYSQL_DATABASE=IOP_Library
MYSQL_USER=iop
MYSQL_PASSWORD=eonu#1234
MYSQL_PORT=3306

# ---- MinIO ----
MINIO_ACCESS_KEY=eonu
MINIO_SECRET_KEY=eonu#1234
MINIO_BUCKET=olt-logs
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Kafka ----
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=9090
# Host that host-networked clients (collector) use to reach Kafka's EXTERNAL
# listener. Keep `localhost` unless the collector runs on a different machine.
KAFKA_EXTERNAL_ADVERTISED_HOST=localhost
KAFKA_TOPIC_REQUEST=collectorRequest
KAFKA_TOPIC_RESPONSE=collectorResponse
KAFKA_GROUP_REQUEST=group-collector-request
KAFKA_GROUP_RESPONSE=group-collector-response

# ---- Backend / Frontend ----
BACKEND_PORT=8080
FRONTEND_PORT=80
# Empty => frontend uses same-origin relative /api (served through nginx).
# Set to e.g. http://10.101.15.238:8080 only to target a remote backend.
VITE_API_BASE=

# ---- Collector ----
# Empty => auto-detect the primary outbound IPv4 (address advertised to OLTs).
COLLECTOR_HOST_IP=

# ---- Build-time proxy (optional) ----
# On the 238 server set these to the corporate proxy; leave empty on WSL.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# Go module proxy for the backend build. Default works on open networks; behind
# a corporate proxy leave as-is (it will use HTTP_PROXY) or set to a reachable mirror.
GOPROXY=https://proxy.golang.org,direct
# Optional Debian apt mirror for the backend runtime image (speeds up JRE/graphviz
# install on slow networks). Leave empty to use the default deb.debian.org.
APT_MIRROR=
# Optional PyPI index mirror for the collector build (speeds up pip on slow
# networks). Leave empty to use the default PyPI.
PIP_INDEX_URL=
